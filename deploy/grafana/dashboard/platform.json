{
  "uid": "zuel-platform",
  "title": "平台概览",
  "description": "P4 步骤五的六个指标：活跃 run、队列积压、沙箱容器与内存、LLM 延迟与失败率、per-user token。",
  "tags": ["zuel"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "还活着的 run",
      "description": "queued 是还没人开跑的，running 与 waiting_approval 是占着资源的。终态不在这里 —— 那只会是一条永远在涨的线。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "zuel_run",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "队列积压",
      "description": "领了但还没 ack 的任务条数。它与 zuel_run{status=\"queued\"} 不是同一个数：两者一起看才分得清「没人领」与「领了跑不完」。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "zuel_task_pending",
          "legendFormat": "pending"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "沙箱容器数",
      "description": "上限由 SANDBOX_MAX_CONTAINER 定。贴着上限跑意味着教师开始排队。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "zuel_sandbox_container",
          "legendFormat": "容器数"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "沙箱合计内存",
      "description": "实际占用，不是 --memory 上限。并发上限直接由剩余内存决定，按上限推算会系统性低估还装得下几个。曲线中断表示 docker 那一刻读不到 —— 那与「占用为 0」是两回事。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "zuel_sandbox_memory_byte",
          "legendFormat": "已用"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "LLM 调用耗时 p95",
      "description": "一次分析内部要调十几轮模型，这里是单轮的分位数，不是整次分析的时长。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(zuel_llm_call_second_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(zuel_llm_call_second_bucket[5m])))",
          "legendFormat": "p50"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "LLM 失败率",
      "description": "失败调用 / 全部调用。分子套 `or vector(0)`：一次失败都还没发生过时，那条序列压根不存在，而 PromQL 里「空 / 数」等于空 —— 面板会一片空白，看起来跟「监控坏了」一模一样。分母为 0 时整条线仍然消失，那才是真的没人在跑分析。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(sum(rate(zuel_llm_call_second_count{outcome=\"error\"}[15m])) or vector(0)) / sum(rate(zuel_llm_call_second_count[15m]))",
          "legendFormat": "失败率"
        }
      ]
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "今日未命中 token（按用户）",
      "description": "窗口是「今天零点起」，与配额重置同一条时间线。命中 prompt cache 的那部分几乎不要钱，不在这里。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "orientation": "horizontal" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (user) (zuel_token_today{kind=\"uncached\"})",
          "legendFormat": "{{user}}",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "平台进程常驻内存",
      "description": "api / broker / worker 自己吃了多少。沙箱之外的那部分容量账。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "process_resident_memory_bytes",
          "legendFormat": "{{job}} {{instance}}"
        }
      ]
    }
  ]
}
